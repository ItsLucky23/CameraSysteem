# This file is a safe config template for .env.
# Keep placeholders like ID_IN_ENV_LOCAL and SECRET_IN_ENV_LOCAL here.
# Store real secrets in .env.local (see .env.local_template).

NODE_ENV=development # development | production
SECURE=false # when true we use https else http, make sure your nginx server is configured to use https if this is set to true
PROJECT_NAME=YOUR_PROJECT_NAME # used for the redis cache so that when using the same template other session data will not collide with this one
SERVER_IP=localhost # this should either be localhost if using a reverse proxy or 0.0.0.0 if you want other devices on your network to access the server to test mobile support for example or networking between devices. have it set to the ip when calling the node server directly
SERVER_PORT=80 # 80 for localhost and for production any port you like e.g 3000

# DNS is used to redirect the user to the server when they login with oauth
# so when NODE_ENV is set to development it should be someting like http://localhost:5173
# and when NODE_ENV is set to production it should be someting like https://app.server.com
DNS=http://localhost:5173

REDIS_HOST=127.0.0.1
REDIS_USERNAME=default
REDIS_PASSWORD=
REDIS_PORT=6379

# Shared secret used by Pi Zero camera nodes for command polling and telemetry ingest APIs.
# Put a strong random value in .env.local in real deployments.
CAMERA_NODE_SHARED_SECRET=SECRET_IN_ENV_LOCAL

# LAN IP that Pi Zero camera nodes use to reach this Pi 5 host for RTP video ingest.
# Must be the Pi 5's LAN address, not 127.0.0.1 or 0.0.0.0. Example: 192.168.1.10
PI5_LAN_IP=SECRET_IN_ENV_LOCAL

# First UDP port used for RTP ingest. Ports are allocated in even increments from this base,
# one per camera. Default 5600.
PI5_VIDEO_INGEST_PORT_BASE=5600

# First UDP port used for AUDIO ingest (Pi Zero mic -> Pi 5). Even increments,
# one per camera. Default 6600.
PI5_AUDIO_INGEST_PORT_BASE=6600

# First UDP port used for AUDIO egress (Pi 5 -> Pi Zero speaker). Even increments,
# one per camera. The Pi Zero's audio_subscriber listens on the allocated port
# from this range. Default 7600.
PI5_AUDIO_EGRESS_PORT_BASE=7600

# Pi 5 thumbnail extractor cadence (seconds). One JPEG per camera per N seconds.
# Drives both the cameras-page thumbnail refresh AND the auto-IR controller's
# re-evaluation interval (auto-IR piggybacks on these frames). Production: 30.
# During dev set to 1 for snappy auto-IR response when testing the IR ring.
# Clamped to [1, 600].
CAMERA_THUMBNAIL_INTERVAL_SEC=30

#here you can add urls that are allowed to communicate with the server, such as oauth urls
#when adding new urls make sure to saperate them with a ','
#DNS is also allowed to communicate with out server on default so no need to add it here again
EXTERNAL_ORIGINS=https://accounts.google.com,https://github.com,https://www.facebook.com,https://discord.com

#https://console.cloud.google.com/apis/credentials
# create a new project, go to credentials, create OAuth clientId
# scroll down to Authorized redirect URIs and add the server ip port and than /auth/callback/google
# so for dev it should be http://localhost:80/auth/callback/google
# copy the google client id and secret.

#USED FOR PRODUCTION
GOOGLE_CLIENT_ID=ID_IN_ENV_LOCAL
GOOGLE_CLIENT_SECRET=SECRET_IN_ENV_LOCAL
#USED FOR DEVELOPMENT
DEV_GOOGLE_CLIENT_ID=ID_IN_ENV_LOCAL
DEV_GOOGLE_CLIENT_SECRET=SECRET_IN_ENV_LOCAL



#https://github.com/settings/developers
# create a new OAuth app, homepage url can be http://localhost:80/auth/callback/github
# callback url should be ip port and than /auth/callback/github, so for dev it should be http://localhost:80/auth/callback/github
# than just copy the client id and secret

#USED FOR PRODUCTION
GITHUB_CLIENT_ID=ID_IN_ENV_LOCAL
GITHUB_CLIENT_SECRET=SECRET_IN_ENV_LOCAL
#USED FOR DEVELOPMENT
DEV_GITHUB_CLIENT_ID=ID_IN_ENV_LOCAL
DEV_GITHUB_CLIENT_SECRET=SECRET_IN_ENV_LOCAL



#https://developers.facebook.com/async/registration/dialog/?src=default
# go to my apps and it want you to create an account, after creating an account you should be able to create a new app
# go to use cases and click customize on 'authenticate and request data from users with facebook login' and then click on quickstart
# after quick setup go to apps ettings - basics and copy the app id and app secret, the callback url for localhost is automaticly handeld but for production you need to change this
# you can change this on use cases and click on 'authenticate and request data from users with facebook login' and then click on 'settings' and go down to valid oauth redirect urls

#USED FOR PRODUCTION
FACEBOOK_CLIENT_ID=ID_IN_ENV_LOCAL
FACEBOOK_CLIENT_SECRET=SECRET_IN_ENV_LOCAL
#USED FOR DEVELOPMENT
DEV_FACEBOOK_CLIENT_ID=ID_IN_ENV_LOCAL
DEV_FACEBOOK_CLIENT_SECRET=SECRET_IN_ENV_LOCAL



#https://discord.com/developers/applications
# create a new application, navigate to OAuth2, copy the client id and secret
# add a redirects url, for dev it should be http://localhost:80/auth/callback/discord

#USED FOR PRODUCTION
DISCORD_CLIENT_ID=ID_IN_ENV_LOCAL
DISCORD_CLIENT_SECRET=SECRET_IN_ENV_LOCAL
#USED FOR DEVELOPMENT
DEV_DISCORD_CLIENT_ID=ID_IN_ENV_LOCAL
DEV_DISCORD_CLIENT_SECRET=SECRET_IN_ENV_LOCAL

#USED FOR PRODUCTION
MICROSOFT_CLIENT_ID=ID_IN_ENV_LOCAL
MICROSOFT_CLIENT_SECRET=SECRET_IN_ENV_LOCAL
#USED FOR DEVELOPMENT
DEV_MICROSOFT_CLIENT_ID=ID_IN_ENV_LOCAL
DEV_MICROSOFT_CLIENT_SECRET=SECRET_IN_ENV_LOCAL


# ============================================
# DATABASE CONFIGURATION
# ============================================
# Set the DATABASE_URL based on your chosen database provider.
# This must match the datasource in prisma/schema.prisma
# 
# After changing providers:
# 1. Update prisma/schema.prisma datasource
# 2. Update DATABASE_URL below
# 3. Run: npm run prisma:generate && npm run prisma:db:push
# ============================================

# --- MYSQL (Default) ---
# DATABASE_URL="mysql://root:SECRET_IN_ENV_LOCAL@localhost:3306/databaseName"

# --- POSTGRESQL ---
# DATABASE_URL="postgresql://root:SECRET_IN_ENV_LOCAL@localhost:5432/databaseName"

# --- MONGODB ---
# DATABASE_URL="mongodb://root:SECRET_IN_ENV_LOCAL@localhost:27017/databaseName"
# With some query parameters 
DATABASE_URL="mongodb://root:SECRET_IN_ENV_LOCAL@localhost:27017/databaseName?authSource=admin&replicaSet=rs0"

# --- SQLITE (No server needed - great for development) ---
# DATABASE_URL="file:./dev.db"

# ============================================
# SENTRY ERROR MONITORING (Optional)
# ============================================
# Get your DSN from https://sentry.io
# Create a project for Node.js (server) and React (client)

# Server-side Sentry DSN
SENTRY_DSN=
# Set to 'true' to enable Sentry in development
SENTRY_ENABLED=false

# Client-side Sentry DSN (must be prefixed with VITE_)
VITE_SENTRY_DSN=
# Set to 'true' to enable Sentry in development
VITE_SENTRY_ENABLED=false