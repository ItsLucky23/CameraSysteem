# Pi5 API base URL (must be reachable from Pi Zero)
PI5_BASE_URL=http://192.168.1.10:80

# Camera identity (must match camera IP configured in admin)
CAMERA_IP=192.168.1.42

# Must match CAMERA_NODE_SHARED_SECRET on Pi5
NODE_SECRET=REPLACE_WITH_CAMERA_NODE_SHARED_SECRET

# Runtime settings
HARDWARE_ADAPTER=rpi
# Idle nap between long-poll re-issues. Long-polling means the Pi 5 already
# holds the request open until a command arrives, so leave this at 0.
POLL_INTERVAL_MS=0
# Backoff after a failed command poll (Pi 5 unreachable / errored).
POLL_ERROR_BACKOFF_MS=1500
# Server-side hold-open for command long-poll. Must be < any upstream proxy
# idle timeout. Pi 5 caps incoming waitMs at 25s.
LONG_POLL_MS=25000
# aiohttp client timeout for the command long-poll request. Must comfortably
# exceed LONG_POLL_MS so a clean idle hold doesn't trip the client side.
LONG_POLL_REQUEST_TIMEOUT_SEC=35
TELEMETRY_INTERVAL_SEC=5
# Pi Zero rpicam-jpeg fallback thumbnail cadence (seconds). Only fires when
# no RTP stream is active (Pi 5 extractor takes over otherwise). Production:
# 30. Dev: 1 for snappy auto-IR feedback even without a viewer connected.
# Match this with CAMERA_THUMBNAIL_INTERVAL_SEC on the Pi 5 for consistent
# behavior across both paths. Clamped to [1, 600].
THUMBNAIL_INTERVAL_SEC=30
COMMAND_BATCH_LIMIT=20
HTTP_TIMEOUT_SEC=8
VERIFY_TLS=true
LOG_LEVEL=INFO

# Camera movement settings
PTZ_STEP=5

# Optional SG90 servo GPIO pins for pan and tilt
# Set these when using Micro Servo 9g (SG90) motors.
PAN_SERVO_GPIO_PIN=12
TILT_SERVO_GPIO_PIN=13

# Optional CPU temp source
CPU_TEMP_PATH=/sys/class/thermal/thermal_zone0/temp

# Infrared control GPIO pin.
# Default 18 matches the V1 wiring (MOSFET gate on physical pin 12).
# AFTER PERFORMING the audio migration (HARDWARE_SUMMARY.md §6.A step 1),
# change this to 17 so the IR LED works once the gate jumper is moved to
# physical pin 11 and GPIO 18 is taken over by the I2S BCLK.
IR_GPIO_PIN=18

# Hands-free IR wiring check. When true, the camera node blinks the IR LED
# twice on boot (right after adapter startup) so you can confirm the MOSFET
# + 12V ring chain is wired correctly without loading the cameras page.
# Leave unset / false in normal operation.
IR_BOOT_SELF_TEST=false

# MOTION DETECTION LOGIC (start)
# # PIR motion sensor (HC-SR501 per HARDWARE_SUMMARY.md).
# # Wire VCC to the 5V red rail, GND to the blue rail, OUT to BCM 7
# # (physical pin 26). When unset, motion detection stays a stub.
# MOTION_GPIO_PIN=7
# MOTION DETECTION LOGIC (end)

# Optional recording commands
# If unset, recordStart/recordStop only update state without launching a process.
RECORDING_START_COMMAND=
RECORDING_STOP_COMMAND=

# 2-way audio (I2S — INMP441 mic + MAX98357A amp).
# Leave unset until HARDWARE_SUMMARY.md §6.A is done. With the I2S bus wired
# and the googlevoicehat overlay active, set both to the ALSA device name
# (typically "plughw:CARD=sndrpigooglevoi") so audio_publisher.py / audio_subscriber.py
# can grab it. Until set, audio commands from the Pi 5 are accepted but no-op.
AUDIO_INPUT_DEVICE=
AUDIO_OUTPUT_DEVICE=
# Opus encoder bitrate (bits per second) for the camera-mic uplink.
# 32000 = good speech quality at low bandwidth. Drop to 16000 if Pi Zero CPU
# headroom is tight, raise to 64000 only if you actually need music quality.
AUDIO_BITRATE_BPS=32000
